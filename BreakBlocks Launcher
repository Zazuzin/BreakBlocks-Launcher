#!/usr/bin/env bash
set -euo pipefail
app_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$app_dir"
if [[ "$(uname -s)" == "Linux" && -f "$app_dir/fonts/fonts.conf" ]]; then
  export FONTCONFIG_PATH="$app_dir/fonts"
  export FONTCONFIG_FILE="fonts.conf"
fi
exec python3 "$app_dir/breakblocks_launcher.py" "$@"
